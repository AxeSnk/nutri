<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- OpenFoodFacts работает и по https; разрешаем дополнительный cleartext на всякий случай -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">world.openfoodfacts.org</domain>
    </domain-config>
</network-security-config>
